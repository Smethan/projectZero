# ESP32-C5 Zero (4 MiB flash, no PSRAM, native USB-Serial/JTAG).
# Apply with: idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.waveshare-zero" build
CONFIG_PROJECTZERO_BOARD_WAVESHARE_ZERO=y

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# The Zero has no external RAM. Do not enable any PSRAM boot or allocator path.
# CONFIG_SPIRAM is not set
# CONFIG_SPIRAM_BOOT_INIT is not set
# CONFIG_SPIRAM_USE_MALLOC is not set
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_8MB is not set
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.waveshare-zero.csv"

# Keep the no-PSRAM image within the factory slot while retaining assertions.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT is not set
# CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE is not set
# CONFIG_ESP_DEBUG_OCDAWARE is not set
# CONFIG_FREERTOS_DEBUG_OCDAWARE is not set

# Keep Wi-Fi working sets in internal RAM; avoid PSRAM-oriented IRAM tradeoffs.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
